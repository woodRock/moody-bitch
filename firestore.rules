rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsNew() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function keepsOwner() { return request.resource.data.userId == resource.data.userId; }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function isNum(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function isInt(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function isTs(v) { return v is timestamp; }
    function onlyKeys(allowed) { return request.resource.data.keys().hasOnly(allowed); }

    // ---- moodEntries: one document per daily log ----------------------
    function validEntry() {
      let d = request.resource.data;
      return onlyKeys(['userId', 'mood', 'energy', 'sleep', 'highlights', 'timestamp'])
        && isInt(d.mood, 1, 10)
        && isInt(d.energy, 1, 10)
        && isNum(d.sleep, 0, 24)
        && d.highlights is list && d.highlights.size() <= 5
        && isTs(d.timestamp);
    }
    match /moodEntries/{entryId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validEntry();
      allow update: if ownsExisting() && keepsOwner() && validEntry();
    }

    // ---- quests --------------------------------------------------------
    function validQuest() {
      let d = request.resource.data;
      return onlyKeys(['userId', 'title', 'description', 'type', 'skill', 'completed', 'lastCompleted', 'createdAt'])
        && isStr(d.title, 80) && d.title.size() > 0
        && isStr(d.description, 2000)
        && d.type in ['daily', 'one-off']
        && isStr(d.skill, 32)
        && d.completed is bool
        && (!('lastCompleted' in d) || d.lastCompleted == null || isTs(d.lastCompleted))
        && (!('createdAt' in d) || isTs(d.createdAt));
    }
    match /quests/{questId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validQuest();
      allow update: if ownsExisting() && keepsOwner() && validQuest();
    }

    // ---- userStats: one document per player, keyed by uid ---------------
    function validStats() {
      let d = request.resource.data;
      return onlyKeys(['name', 'level', 'xp', 'xpToNextLevel', 'health', 'magicka', 'stamina', 'healthMax', 'magickaMax',
                       'staminaMax', 'skillPoints', 'pendingLevelUps', 'race', 'perks', 'skills', 'inventory', 'equippedItemId',
                       'completedQuestCount', 'surgeEndTime', 'slowTimeEndTime', 'zenMode', 'trackLocation', 'bestStreak'])
        && isStr(d.name, 24)
        && isInt(d.level, 1, 1000)
        && isNum(d.xp, 0, 10000000) && isNum(d.xpToNextLevel, 1, 100000000)
        && isNum(d.health, 0, 10000) && isNum(d.magicka, 0, 10000) && isNum(d.stamina, 0, 10000)
        && isNum(d.healthMax, 1, 10000) && isNum(d.magickaMax, 1, 10000) && isNum(d.staminaMax, 1, 10000)
        && isInt(d.skillPoints, 0, 1000) && isInt(d.pendingLevelUps, 0, 1000)
        && isStr(d.race, 24)
        && d.perks is list && d.perks.size() <= 200
        && d.skills is map && d.skills.size() <= 16
        && d.inventory is list && d.inventory.size() <= 60
        && (d.equippedItemId == null || isStr(d.equippedItemId, 40))
        && isInt(d.completedQuestCount, 0, 1000000)
        && isNum(d.surgeEndTime, 0, 10000000000000) && isNum(d.slowTimeEndTime, 0, 10000000000000)
        && d.zenMode is bool && d.trackLocation is bool
        && isInt(d.bestStreak, 0, 100000);
    }
    match /userStats/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validStats();
    }

    // ---- locationHistory: where notable things happened ---------------
    function validLocation() {
      let d = request.resource.data;
      return onlyKeys(['userId', 'lat', 'lng', 'timestamp', 'label'])
        && isNum(d.lat, -90, 90) && isNum(d.lng, -180, 180)
        && isTs(d.timestamp)
        && (!('label' in d) || isStr(d.label, 120));
    }
    match /locationHistory/{locationId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validLocation();
      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
